{
  "name": "arc-bot",
  "version": "1.1.0",
  "description": "ARC (AI Remote Coding) - Control AI coding agents via messaging apps",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "arc-bot": "./bin/arc-bot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop arc",
    "pm2:restart": "pm2 restart arc",
    "pm2:logs": "pm2 logs arc",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@ngrok/ngrok": "^1.7.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "dotenv": "^16.4.5",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^7.0.6",
    "inquirer": "^9.3.7",
    "node-telegram-bot-api": "^0.66.0",
    "pm2": "^5.4.3",
    "proxy-agent": "^6.5.0",
    "qrcode": "^1.5.4",
    "socks": "^2.8.7"
  },
  "optionalDependencies": {
    "playwright": "^1.58.2"
  }
}
